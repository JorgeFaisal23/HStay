# Configuración de producción para docker compose. Cópialo a .env.production
# (está en .gitignore) y úsalo así:
#
#   docker compose --env-file .env.production up -d --build
#
# --env-file alimenta las variables ${...} de docker-compose.yml (base de datos
# y argumentos de build); env_file las pasa al contenedor en ejecución.

# PostgreSQL del servicio `db`. DATABASE_URL la arma docker-compose.yml con estos
# valores; si usas una base externa, define DATABASE_URL y DIRECT_URL aquí.
POSTGRES_DB=apprentas
POSTGRES_USER=apprentas
POSTGRES_PASSWORD=cambia-esta-contrasena

# Clave para firmar sesiones: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Puerto del host donde queda publicada la app (detrás de tu proxy inverso).
APP_PORT=3000

# Identidad del producto (se incrusta al compilar la imagen).
NEXT_PUBLIC_APP_NAME=HStay
NEXT_PUBLIC_APP_TAGLINE=Administración de rentas
NEXT_PUBLIC_APP_COLOR=#12263F
NEXT_PUBLIC_APP_URL=

# Correo al que las arrendadoras escriben para cambiar de plan (opcional).
SUPPORT_EMAIL=

# Correo (opcional). Con SMTP_HOST y MAIL_FROM, las invitaciones y la
# recuperación de contraseña llegan como enlaces por correo; sin ellos, quien
# da de alta o restablece una cuenta recibe una contraseña temporal para
# entregarla. Sirve cualquier SMTP: Gmail con contraseña de aplicación
# (smtp.gmail.com, 587), Brevo, el del hosting…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mi Plataforma <no-responder@midominio.com>"
# URL pública de la app: base de los enlaces de los correos. Obligatoria en
# producción para enviar enlaces (no se arma con el encabezado Host, que se
# puede falsificar).
APP_URL=

# Cookie de sesión `secure`. Vacío: la decide el encabezado X-Forwarded-Proto
# que manda el proxy (https → secure). "true" la fuerza; "false" la apaga.
# Sin proxy ni HTTPS (una prueba por http://IP:3000) déjalo vacío o en "false".
COOKIE_SECURE=

# Nunca "true" en producción.
DEMO_MODE=false
