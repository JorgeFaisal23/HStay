# Conexión de la app a PostgreSQL.
DATABASE_URL="postgresql://usuario:password@localhost:5432/apprentas"
# Conexión que usa Prisma para migrar. Igual a DATABASE_URL salvo que la app
# pase por un pooler de conexiones (las migraciones necesitan conexión directa).
DIRECT_URL="postgresql://usuario:password@localhost:5432/apprentas"
AUTH_SECRET="genera-uno-con: node -e \"console.log(require('crypto').randomBytes(32).toString('base64url'))\""

# Identidad del producto (HStay). Se incrustan en el build (cambiarlas requiere
# recompilar).
NEXT_PUBLIC_APP_NAME="HStay"
NEXT_PUBLIC_APP_TAGLINE="Administración de rentas"
NEXT_PUBLIC_APP_COLOR="#12263F"
NEXT_PUBLIC_APP_URL=""

# "true" muestra las cuentas de prueba en el acceso. Nunca en producción.
DEMO_MODE="true"

# Correo al que las arrendadoras escriben para cambiar de plan (se muestra en
# /premium). Opcional.
SUPPORT_EMAIL=""

# Correo (opcional). Con SMTP_HOST y MAIL_FROM, las invitaciones y la
# recuperación de contraseña llegan como enlaces por correo; sin ellos, quien
# da de alta o restablece una cuenta recibe una contraseña temporal para
# entregarla. Sirve cualquier SMTP: Gmail con contraseña de aplicación
# (smtp.gmail.com, 587), Brevo, el del hosting…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mi Plataforma <no-responder@midominio.com>"
# URL pública de la app: base de los enlaces de los correos. Obligatoria en
# producción para enviar enlaces (no se arma con el encabezado Host, que se
# puede falsificar).
APP_URL=

# --- Solo desarrollo (ponlas en .env.local, que gana sobre .env) ---
# Base auxiliar vacía que usa `prisma migrate dev` para calcular diferencias.
SHADOW_DATABASE_URL="postgresql://postgres@localhost:5433/apprentas_shadow"
# Base de las pruebas de integración (npm run test:int). Debe ser distinta de
# DATABASE_URL: las pruebas crean y borran sus propias arrendadoras ahí.
TEST_DATABASE_URL="postgresql://postgres@localhost:5433/apprentas_test"
# Correo del superadministrador que crea el seed (por defecto super@demo.mx).
SEED_SUPERADMIN_EMAIL="super@demo.mx"
